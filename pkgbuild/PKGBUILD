pkgname=omni-video-generator
pkgver=0.1.0
pkgrel=1
pkgdesc='Local MiniMax H3 video generation through ComfyUI'
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'xdg-desktop-portal' 'ffmpeg' 'util-linux')
optdepends=('nvidia-utils: VRAM measurements')
makedepends=('gcc' 'make' 'git')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omni-video-generator "$pkgdir/usr/bin/omni-video-generator"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$startdir/omni-video-generator.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omni-video-generator.svg"
  install -Dm644 "$startdir/omni-video-generator.desktop" "$pkgdir/usr/share/applications/omni-video-generator.desktop"
}
