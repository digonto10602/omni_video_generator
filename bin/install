#!/bin/sh
# Builds the Arch package and installs it. pkexec shows a password pop-up;
# nothing else on the system is changed.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"
cd "$ROOT/pkgbuild"
makepkg -f "$@"
PKG="$(ls -t omni-video-generator-[0-9]*.pkg.tar.* | head -n1)"
exec pkexec pacman -U --noconfirm "$ROOT/pkgbuild/$PKG"
